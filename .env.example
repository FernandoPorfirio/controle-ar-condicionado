# Copie para .env e preencha. O .env NÃO é versionado.

# Token pessoal gerado em https://connect-pat.lgthinq.com
THINQ_PAT=

# País da conta LG (define o servidor regional). Ex.: BR
THINQ_COUNTRY=BR

# Identificador do cliente (qualquer UUID fixo gerado por você)
THINQ_CLIENT_ID=

# Opcional: qual ar controlar, se a conta tiver mais de um. Vazio = o primeiro.
# O ID aparece no app em Configurações > Aparelhos na conta.
THINQ_DEVICE_ID=
